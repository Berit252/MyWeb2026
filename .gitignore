# ==========================
# 操作系统生成的文件 (OS Generated)
# ==========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==========================
# 编辑器配置文件 (Editor)
# ==========================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# 历史记录缓存
.history/

# ==========================
# 依赖与环境 (Dependencies)
# ==========================
# 虽然你现在用的是 CDN，但为了防止以后用 npm，建议加上
node_modules/
dist/
build/

# ==========================
# 环境变量与安全 (Security)
# ==========================
# 绝对不要上传包含密钥的文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================
# 日志文件 (Logs)
# ==========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================
# 设计工程源文件与大文件 (Design & 3D Assets)
# ==========================
# 防止误提交流程中的大型源文件
*.psd
*.ai
*.xd
*.sketch
*.blend
*.blend1
*.blend2

# 避免上传未经压缩的超大本地归档备份
*.zip
*.rar
*.7z
*.tar.gz

# 追加本地构建缓存与日志
.pnpm-debug.log*
.eslintcache
.parcel-cache/